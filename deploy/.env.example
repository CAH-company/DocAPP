# Wartości generuje install.sh. Plik .env: chmod 600, właściciel root. NIE commituj.
APP_IMAGE=ghcr.io/CHANGE_ME/obieg-rachunkow:latest-pinned-by-installer
DOMAIN=
ADMIN_EMAIL=
APP_URL=

NODE_ENV=production

# Antywirus. Produkcja: CLAMAV_ENABLED=true i COMPOSE_PROFILES=av (wymaga ok. 2 GB RAM).
# Wersja testowa bez ClamAV: CLAMAV_ENABLED=false i COMPOSE_PROFILES= (puste).
CLAMAV_ENABLED=true
COMPOSE_PROFILES=av

DEMO_MODE=false
FEATURE_PESEL=false

POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=

MASTER_KEY=
MASTER_KEY_ID=k1
# Rotacja kluczy: stare klucze tylko do odczytu, format "k0:<hex64>,k00:<hex64>"
MASTER_KEYS_PREVIOUS=
AUTH_SECRET=

STORAGE_DRIVER=local
MAX_UPLOAD_MB=20
# Tylko przy STORAGE_DRIVER=s3 (pliki i tak są szyfrowane przez aplikację)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOW_INSECURE=false

# Backup (MAINTENANCE.md §4)
RESTIC_PASSWORD=
BACKUP_DISK_PATH=/mnt/backup
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_SCHEDULE=0 2 * * *
